[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.2
reloadable = true

[libraries]

macos.debug = "res://bin/debug/libalgochat_godot.dylib"
macos.release = "res://bin/debug/libalgochat_godot.dylib"
linux.debug.x86_64 = "res://bin/debug/libalgochat_godot.so"
linux.release.x86_64 = "res://bin/debug/libalgochat_godot.so"
linux.debug.arm64 = "res://bin/debug/libalgochat_godot.so"
linux.release.arm64 = "res://bin/debug/libalgochat_godot.so"
windows.debug.x86_64 = "res://bin/debug/algochat_godot.dll"
windows.release.x86_64 = "res://bin/debug/algochat_godot.dll"
